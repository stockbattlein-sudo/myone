# ──────────────────────────────────────────────
# StockBattle — Environment Variables
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# ── Database ──────────────────────────────────
DATABASE_URL="postgresql://stockbattle:stockbattle_dev@localhost:5432/stockbattle"

# ── Redis ─────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth / JWT ────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-jwt-secret-here-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-here-min-32-chars"

# ── Email (Resend — primary) ─────────────────
# Get your API key at https://resend.com
# Leave blank to use console-logger fallback in dev
RESEND_API_KEY=""
EMAIL_FROM="StockBattle <noreply@stockbattle.in>"

# ── Email (Gmail — dev fallback) ──────────────
# Only used if RESEND_API_KEY is blank AND these are set
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# ── SMS (MSG91 — stubbed until Phase 5+) ──────
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""

# ── CORS / Cookies ────────────────────────────
# Frontend URL — used for CORS origin and cookie domain
CORS_ORIGIN="http://localhost:3000"
COOKIE_DOMAIN="localhost"

# ── App ───────────────────────────────────────
NODE_ENV="development"
PORT=3001
